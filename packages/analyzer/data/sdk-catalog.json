    {
      "id": "admob",
      "name": "Google AdMob",
      "categories": ["ads", "tracking"],
      "privacy": ["identifiers", "usage_data"],
      "implications": [
        "Apple requires App Tracking Transparency and NSUserTrackingUsageDescription when the advertising identifier is used for tracking.",
        "Google Play requires the Advertising ID permission to be declared and the ads presence answered in Data Safety."
      ],
      "match": {
        "npm": ["react-native-google-mobile-ads", "expo-ads-admob"],
        "pub": ["google_mobile_ads"],
        "pod": ["Google-Mobile-Ads-SDK", "GoogleMobileAds"],
        "gradle": ["com.google.android.gms:play-services-ads"]
      }
    },
    {
      "id": "meta-sdk",
      "name": "Meta (Facebook) SDK",
      "categories": ["ads", "tracking", "analytics"],
      "privacy": ["identifiers", "usage_data", "contact_info"],
      "implications": [
        "Attribution through the Meta SDK counts as tracking for Apple's App Tracking Transparency."
      ],
      "match": {
        "npm": ["react-native-fbsdk-next"],
        "pub": ["facebook_app_events", "flutter_facebook_auth"],
        "pod": ["FBSDKCoreKit", "FBSDKLoginKit"],
        "gradle": [
          "com.facebook.android:facebook-android-sdk",
          "com.facebook.android:facebook-core"
        ]
      }
    },
    {
      "id": "sentry",
