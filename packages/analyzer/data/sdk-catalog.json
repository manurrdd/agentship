{
  "schemaVersion": 1,
  "lastVerified": "2026-08-03",
  "comment": "Third-party SDKs whose presence changes what a publisher must declare or configure in a store. Matching is by dependency name per ecosystem: npm (package.json), pub (pubspec.yaml), pod (Podfile / Podfile.lock) and gradle (Maven group:artifact). Matches are exact, case-insensitive; `prefix` entries match any dependency starting with the given string. `privacy` lists the data types the SDK typically causes an app to collect — a proposal for the user to confirm, never a declaration Agentship makes on their behalf.",
  "sdks": [
    {
      "id": "firebase-core",
      "name": "Firebase",
      "categories": ["analytics"],
      "privacy": ["identifiers", "diagnostics"],
      "implications": [
        "Firebase collects an installation identifier by default; both stores expect it to be declared."
      ],
      "match": {
        "npm": ["firebase", "@react-native-firebase/app"],
        "pub": ["firebase_core"],
        "pod": ["Firebase", "FirebaseCore"],
        "gradle": ["com.google.firebase:firebase-common", "com.google.gms:google-services"]
      }
    },
    {
      "id": "firebase-analytics",
      "name": "Firebase Analytics",
      "categories": ["analytics"],
      "privacy": ["usage_data", "identifiers"],
      "implications": [
        "Analytics events and an advertising/app-instance identifier must be declared in App Privacy and Data Safety."
      ],
      "match": {
        "npm": ["@react-native-firebase/analytics"],
        "pub": ["firebase_analytics"],
        "pod": ["Firebase/Analytics", "FirebaseAnalytics"],
        "gradle": ["com.google.firebase:firebase-analytics"]
      }
    },
    {
      "id": "firebase-crashlytics",
      "name": "Firebase Crashlytics",
      "categories": ["crash"],
      "privacy": ["diagnostics"],
      "implications": ["Crash reports count as diagnostics data in both stores."],
      "match": {
        "npm": ["@react-native-firebase/crashlytics"],
        "pub": ["firebase_crashlytics"],
        "pod": ["Firebase/Crashlytics", "FirebaseCrashlytics"],
        "gradle": ["com.google.firebase:firebase-crashlytics"]
      }
    },
    {
      "id": "firebase-messaging",
      "name": "Firebase Cloud Messaging",
      "categories": ["push"],
      "privacy": ["identifiers"],
      "implications": [
        "Push requires an APNs key or certificate for iOS, configured in Apple's developer portal.",
        "iOS requires the Push Notifications capability in the app's entitlements."
      ],
      "match": {
        "npm": ["@react-native-firebase/messaging"],
        "pub": ["firebase_messaging"],
        "pod": ["Firebase/Messaging", "FirebaseMessaging"],
        "gradle": ["com.google.firebase:firebase-messaging"]
      }
    },
    {
      "id": "firebase-auth",
      "name": "Firebase Authentication",
      "categories": ["auth"],
      "privacy": ["contact_info", "identifiers"],
      "implications": [
        "If the app offers any third-party sign-in, Apple requires Sign in with Apple as an equivalent option."
      ],
      "match": {
        "npm": ["@react-native-firebase/auth"],
        "pub": ["firebase_auth"],
        "pod": ["Firebase/Auth", "FirebaseAuth"],
        "gradle": ["com.google.firebase:firebase-auth"]
      }
    },
    {
      "id": "firebase-storage",
      "name": "Cloud Storage for Firebase",
      "categories": ["storage"],
      "privacy": ["user_content"],
      "implications": [],
      "match": {
        "npm": ["@react-native-firebase/storage", "@react-native-firebase/firestore"],
        "pub": ["firebase_storage", "cloud_firestore"],
        "pod": ["Firebase/Storage", "FirebaseStorage", "FirebaseFirestore"],
        "gradle": ["com.google.firebase:firebase-storage", "com.google.firebase:firebase-firestore"]
      }
    },
    {
      "id": "revenuecat",
      "name": "RevenueCat",
      "categories": ["purchases"],
      "privacy": ["purchases", "identifiers"],
      "implications": [
        "In-app purchase products must exist in App Store Connect and Play Console before a build using them can be reviewed.",
        "Paid apps require completed tax and banking agreements in both stores."
      ],
      "match": {
        "npm": ["react-native-purchases", "@revenuecat/purchases-js"],
        "pub": ["purchases_flutter"],
        "pod": ["RevenueCat", "Purchases"],
        "gradle": ["com.revenuecat.purchases:purchases"]
      }
    },
    {
      "id": "storekit",
      "name": "StoreKit (Apple in-app purchases)",
      "categories": ["purchases"],
      "privacy": ["purchases"],
      "implications": [
        "Requires in-app purchase products configured in App Store Connect and the paid applications agreement signed."
      ],
      "match": {
        "npm": ["react-native-iap", "expo-in-app-purchases"],
        "pub": ["in_app_purchase", "in_app_purchase_storekit"],
        "pod": ["StoreKit"],
        "gradle": []
      }
    },
    {
      "id": "play-billing",
      "name": "Google Play Billing",
      "categories": ["purchases"],
      "privacy": ["purchases"],
      "implications": [
        "Requires in-app products or subscriptions configured in Play Console, and a completed merchant account."
      ],
      "match": {
        "npm": ["react-native-iap"],
        "pub": ["in_app_purchase_android"],
        "pod": [],
